#!/usr/bin/env python3
"""steamspace - map Steam app IDs to game names and find leftover folders.

Usage:
  steamspace 570 730 1245620    look up the given app IDs
  steamspace                    scan the current directory: each numeric
                                subdirectory is treated as an app ID and
                                shown with its disk usage (du -h style)
  steamspace -d ~/.steam/steam/steamapps/compatdata
                                scan a specific directory
  steamspace -u                 only list leftover folders of uninstalled games
  steamspace -C -S              scan compatdata and shadercache in every
                                Steam library (combine with -u for leftovers)
  steamspace -C -S --delete     delete leftover folders of uninstalled games,
                                after listing them and asking for confirmation
  steamspace -G                 scan steamapps/common (installed game files) in
                                every Steam library; folders no appmanifest claims
                                are highlighted as uninstalled (combine with -u)
  steamspace -P                 list extra Proton versions (compatibilitytools.d)
                                and their sizes; combine with -C/-S/-G/-d

Names come from local Steam library manifests (appmanifest_<id>.acf) first,
then from the Steam store API. API results are cached in
$XDG_CACHE_HOME/steamspace/names.json (default ~/.cache).

An app counts as installed when any Steam library on this machine has an
appmanifest for it. Folders for apps without one are reported as
"uninstalled" (leftovers that are usually safe to delete). IDs of 2^31 and
up belong to non-Steam shortcuts and are reported as "non-Steam". ID 0 is
Steam's own compatdata template and is reported as "internal".

In steamapps/common (-G) folders are named after the game, not its app ID, so
each folder is matched against the "installdir" of the appmanifests in the same
library. A folder no manifest there claims is reported as "uninstalled".
"""

import argparse
import json
import math
import os
import re
import shutil
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

STORE_API = "https://store.steampowered.com/api/appdetails?appids={}&filters=basic"
CACHE_FILE = (
    Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    / "steamspace"
    / "names.json"
)
STEAM_ROOTS = [
    Path.home() / ".local/share/Steam",
    Path.home() / ".steam/steam",
    Path.home() / ".steam/root",
    Path.home() / ".var/app/com.valvesoftware.Steam/.local/share/Steam",  # Flatpak
]
OLD_CACHE_FILE = CACHE_FILE.parent.parent / "steamname" / "names.json"
UNKNOWN = "?"


# ---------------------------------------------------------------- local lookup

def steam_library_dirs(missing=None):
    """Return every steamapps directory we can find, including extra libraries.

    If `missing` is a list, libraries named in libraryfolders.vdf that can't be
    found (e.g. an unmounted drive) are appended to it.
    """
    found = []
    seen = set()

    def add(p, configured=False):
        p = Path(p).expanduser()
        try:
            key = p.resolve()
        except OSError:
            return
        if key in seen:
            return
        if p.is_dir():
            seen.add(key)
            found.append(p)
        elif configured and missing is not None and p not in missing:
            missing.append(p)

    for root in STEAM_ROOTS:
        steamapps = root / "steamapps"
        add(steamapps)
        vdf = steamapps / "libraryfolders.vdf"
        try:
            text = vdf.read_text(errors="replace")
        except OSError:
            continue
        for path in re.findall(r'"path"\s+"([^"]+)"', text):
            add(Path(path.replace("\\\\", "\\")) / "steamapps", configured=True)
    if missing is not None:  # a missing path may have been found via another root
        found_keys = {p.resolve() for p in found}
        missing[:] = [m for m in missing if m.resolve() not in found_keys]
    return found


def local_names():
    """Map app ID -> name from installed games' appmanifest files."""
    names = {}
    for lib in steam_library_dirs():
        for acf in lib.glob("appmanifest_*.acf"):
            try:
                text = acf.read_text(errors="replace")
            except OSError:
                continue
            m_id = re.search(r'"appid"\s+"(\d+)"', text)
            m_name = re.search(r'"name"\s+"([^"]*)"', text)
            if m_id and m_name:
                names[m_id.group(1)] = m_name.group(1)
    return names


def library_installdirs(lib):
    """Map installdir -> (app ID, name) from the appmanifests in one steamapps dir."""
    dirs = {}
    for acf in lib.glob("appmanifest_*.acf"):
        try:
            text = acf.read_text(errors="replace")
        except OSError:
            continue
        m_dir = re.search(r'"installdir"\s+"([^"]+)"', text)
        if not m_dir:
            continue
        m_id = re.search(r'"appid"\s+"(\d+)"', text)
        m_name = re.search(r'"name"\s+"([^"]*)"', text)
        dirs[m_dir.group(1)] = (m_id.group(1) if m_id else UNKNOWN,
                                m_name.group(1) if m_name else m_dir.group(1))
    return dirs


# ---------------------------------------------------------------- remote lookup

def load_cache():
    for f in (CACHE_FILE, OLD_CACHE_FILE):  # fall back to the pre-rename cache
        try:
            return json.loads(f.read_text())
        except (OSError, ValueError):
            pass
    return {}


def save_cache(cache):
    try:
        CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
        tmp = CACHE_FILE.with_suffix(".tmp")
        tmp.write_text(json.dumps(cache, indent=1, sort_keys=True))
        tmp.replace(CACHE_FILE)
    except OSError as e:
        print(f"steamspace: could not write cache: {e}", file=sys.stderr)


def fetch_name(appid):
    """Return (appid, name or None, ok). ok=False means a network error (don't cache)."""
    req = urllib.request.Request(
        STORE_API.format(appid),
        headers={"User-Agent": "steamspace/1.0", "Accept-Language": "en"},
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.load(resp)
    except (urllib.error.URLError, TimeoutError, ValueError, OSError):
        return appid, None, False
    entry = (data or {}).get(appid) or {}
    if entry.get("success"):
        return appid, entry.get("data", {}).get("name"), True
    return appid, None, True  # Steam says no such store app (tool, server, delisted...)


SHORTCUT_MIN = 2**31  # non-Steam shortcut app IDs have the top bit set
INTERNAL = {"0": "(Steam template)"}  # compatdata/0 is Steam's prefix template


def status(appid, local, have_libs):
    """'installed', 'uninstalled', 'internal', 'non-Steam', or '?' (no Steam library found)."""
    if appid in INTERNAL:
        return "internal"
    if int(appid) >= SHORTCUT_MIN:
        return "non-Steam"
    if not have_libs:
        return "?"
    return "installed" if appid in local else "uninstalled"


def resolve(appids, local, offline=False, refresh=False):
    """Map each app ID to a name (or None). `local` is the manifest name map."""
    names = {}
    cache = load_cache()
    todo = []
    for a in appids:
        if a in INTERNAL:
            names[a] = INTERNAL[a]
        elif a in local:
            names[a] = local[a]
        elif a in cache and not refresh:
            names[a] = cache[a]
        else:
            names[a] = None
            if not offline and int(a) < SHORTCUT_MIN:
                todo.append(a)

    if todo:
        failed = 0
        with ThreadPoolExecutor(max_workers=4) as pool:
            for appid, name, ok in pool.map(fetch_name, todo):
                if ok:
                    cache[appid] = name
                    names[appid] = name
                else:
                    failed += 1
        save_cache(cache)
        if failed:
            print(
                f"steamspace: {failed} lookup(s) failed (network?); shown as '{UNKNOWN}'",
                file=sys.stderr,
            )
    return names


# ---------------------------------------------------------------- disk usage

def disk_usage(path, seen_inodes):
    """Allocated bytes under path, like `du` (no symlink following, hardlinks counted once)."""
    total = 0
    stack = [path]
    while stack:
        p = stack.pop()
        try:
            st = os.lstat(p)
        except OSError:
            continue
        key = (st.st_dev, st.st_ino)
        if st.st_nlink > 1:
            if key in seen_inodes:
                continue
            seen_inodes.add(key)
        total += st.st_blocks * 512
        if os.path.isdir(p) and not os.path.islink(p):
            try:
                with os.scandir(p) as it:
                    stack.extend(e.path for e in it)
            except OSError:
                pass
    return total


def human(n):
    """Format bytes the way `du -h` does (1024-based, rounded up)."""
    if n < 1024:
        return str(n)
    for unit in "KMGTPE":
        n /= 1024
        if n < 10:
            v = math.ceil(n * 10) / 10
            if v < 10:
                return f"{v:.1f}{unit}"
            n = v
        if math.ceil(n) < 1024:
            return f"{math.ceil(n)}{unit}"
    return f"{math.ceil(n)}Z"


# ---------------------------------------------------------------- directory scan

def scan_dir(base, args, local, have_libs):
    """Return rows (size, id, label, state, path) for one directory, or None on error."""
    try:
        subdirs = [e for e in os.scandir(base) if e.is_dir(follow_symlinks=False)]
    except OSError as e:
        print(f"steamspace: {e}", file=sys.stderr)
        return None

    if args.uninstalled:
        subdirs = [e for e in subdirs
                   if e.name.isdigit() and status(e.name, local, have_libs) == "uninstalled"]
    ids = [e.name for e in subdirs if e.name.isdigit()]
    names = resolve(ids, local, args.offline, args.refresh) if ids else {}

    seen = set()
    rows = []
    for e in subdirs:
        if e.name.isdigit():
            label = names.get(e.name) or UNKNOWN
            state = status(e.name, local, have_libs)
        elif args.all:
            label, state = "(not an app ID)", ""
        else:
            continue
        rows.append((disk_usage(e.path, seen), e.name, label, state, Path(e.path)))

    if args.sort == "size":
        rows.sort(key=lambda r: r[0], reverse=True)
    elif args.sort == "id":
        rows.sort(key=lambda r: (not r[1].isdigit(), int(r[1]) if r[1].isdigit() else 0, r[1]))
    else:
        rows.sort(key=lambda r: r[2].lower())
    return rows


# Folders Steam itself keeps in steamapps/common that no appmanifest claims.
COMMON_INTERNAL = {
    "Steam Controller Configs": "(Steam internal: controller configurations)",
}


def scan_common(base, args, other_libs):
    """Rows (size, folder, label, state, path) for a steamapps/common dir, or None on error.

    A folder is installed when an appmanifest in the same library names it as its
    installdir. `other_libs` are the remaining libraries, used only to note when a
    leftover folder belongs to a game that is installed somewhere else.
    """
    try:
        subdirs = [e for e in os.scandir(base) if e.is_dir(follow_symlinks=False)]
    except OSError as e:
        print(f"steamspace: {e}", file=sys.stderr)
        return None

    here = library_installdirs(base.parent)
    here_ci = {k.lower(): v for k, v in here.items()}
    elsewhere = {}
    for lib in other_libs:
        for k, v in library_installdirs(lib).items():
            elsewhere.setdefault(k.lower(), v)

    seen = set()
    rows = []
    for e in subdirs:
        match = here.get(e.name) or here_ci.get(e.name.lower())
        if e.name in COMMON_INTERNAL:
            state, label = "internal", COMMON_INTERNAL[e.name]
        elif match:
            state = "installed"
            label = match[1] if match[1] != e.name else ""
        else:
            state = "uninstalled"
            other = elsewhere.get(e.name.lower())
            label = (f"(no appmanifest here; {other[1]} is installed in another library)"
                     if other else "(no appmanifest)")
        if args.uninstalled and state != "uninstalled":
            continue
        rows.append((disk_usage(e.path, seen), e.name, label, state, Path(e.path)))

    if args.sort == "size":
        rows.sort(key=lambda r: r[0], reverse=True)
    elif args.sort == "id":
        rows.sort(key=lambda r: r[1].lower())
    else:
        rows.sort(key=lambda r: (r[2] or r[1]).lower())
    return rows


def use_color():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR") \
        and os.environ.get("TERM") != "dumb"


HIGHLIGHT = "\033[1;33m"  # bold yellow
RESET = "\033[0m"


def print_rows(base, rows, args):
    """Print the size/status/name table for one directory. Returns an exit code."""
    if not rows:
        if args.uninstalled:
            print("        (no leftovers from uninstalled apps)")
            return 0
        what = "game folders" if base.name == "common" else "app-ID subdirectories"
        print(f"steamspace: no {what} in {base}", file=sys.stderr)
        return 1

    id_w = max(len(r[1]) for r in rows)
    color = use_color()
    total = leftover = n_leftover = 0
    for size, name, label, state, _ in rows:
        total += size
        line = f"{human(size):>6}  {name:<{id_w}}  {state:<11}  {label}".rstrip()
        if state == "uninstalled":
            leftover += size
            n_leftover += 1
            if color:
                line = HIGHLIGHT + line + RESET
        print(line)
    print(f"{human(total):>6}  {'total':<{id_w}}")
    if n_leftover and not args.uninstalled:
        s = "" if n_leftover == 1 else "s"
        print(f"{human(leftover):>6}  in {n_leftover} folder{s} of uninstalled apps "
              f"(add -u to list only those)")
    return 0


# ---------------------------------------------------------------- proton versions

SYSTEM_COMPAT_DIRS = [
    Path("/usr/share/steam/compatibilitytools.d"),        # AUR packages (proton-ge-custom etc.)
    Path("/usr/local/share/steam/compatibilitytools.d"),
]
FLATPAK_COMPAT_DIR = Path.home() / ".var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d"


def compat_tool_dirs():
    """Every existing compatibilitytools.d directory (user, Flatpak and system-wide)."""
    found, seen = [], set()
    candidates = ([r / "compatibilitytools.d" for r in STEAM_ROOTS]
                  + [FLATPAK_COMPAT_DIR] + SYSTEM_COMPAT_DIRS)
    for d in candidates:
        try:
            key = d.resolve()
        except OSError:
            continue
        if key not in seen and d.is_dir():
            seen.add(key)
            found.append(d)
    return found


def tool_display_name(tool_dir):
    """The display_name from a tool's compatibilitytool.vdf, if it has one."""
    try:
        text = (tool_dir / "compatibilitytool.vdf").read_text(errors="replace")
    except OSError:
        return None
    m = re.search(r'"display_name"\s+"([^"]*)"', text)
    return m.group(1) if m else None


def report_proton(args):
    """Print size and name of each tool in every compatibilitytools.d. Returns exit code."""
    dirs = compat_tool_dirs()
    if not dirs:
        print("steamspace: no compatibilitytools.d directory found "
              "(no extra Proton versions installed)", file=sys.stderr)
        return 1
    grand = 0
    for n, d in enumerate(dirs):
        print(("\n" if n else "") + f"== {d}")
        try:
            tools = [Path(e.path) for e in os.scandir(d) if e.is_dir()]
        except OSError as e:
            print(f"steamspace: {e}", file=sys.stderr)
            continue
        if not tools:
            print("        (empty)")
            continue
        seen = set()
        rows = [(disk_usage(str(t), seen), t.name,
                 tool_display_name(t) or "(no compatibilitytool.vdf)") for t in tools]
        if args.sort == "size":
            rows.sort(key=lambda r: r[0], reverse=True)
        elif args.sort == "id":
            rows.sort(key=lambda r: r[1].lower())
        else:
            rows.sort(key=lambda r: r[2].lower())
        w = max(len(r[1]) for r in rows)
        total = 0
        for size, name, display in rows:
            total += size
            print(f"{human(size):>6}  {name:<{w}}  {display}")
        print(f"{human(total):>6}  total")
        grand += total
    if len(dirs) > 1:
        print(f"\n{human(grand):>6}  in extra Proton versions, across all {len(dirs)} directories")
    return 0


# ---------------------------------------------------------------- deletion

def delete_leftovers(results, missing_libs):
    """Show what would be deleted, ask for confirmation, then delete. Returns exit code."""
    if missing_libs:
        print("steamspace: refusing to delete: these Steam libraries are listed in "
              "libraryfolders.vdf but can't be found (unmounted drive?):", file=sys.stderr)
        for m in missing_libs:
            print(f"    {m}", file=sys.stderr)
        print("Games installed there would wrongly look uninstalled. Mount the drive "
              "(or remove the library in Steam) and try again.", file=sys.stderr)
        return 1

    victims = [(size, appid, label, path)
               for _, rows in results
               for size, appid, label, state, path in rows if state == "uninstalled"]
    if not victims:
        print("Nothing to delete: no leftover folders from uninstalled apps.")
        return 0

    total = sum(v[0] for v in victims)
    id_w = max(len(v[1]) for v in victims)
    s = "" if len(victims) == 1 else "s"
    print(f"The following {len(victims)} folder{s} belong to apps that are not installed "
          f"in any Steam library\nand will be PERMANENTLY deleted:\n")
    for size, appid, label, path in victims:
        print(f"{human(size):>6}  {appid:<{id_w}}  {label}")
        print(f"        {path}")
    print(f"\n{human(total):>6}  total to be freed")
    if any(v[3].parent.name == "compatdata" for v in victims):
        print("\nNote: compatdata folders are Proton prefixes. Some games keep their "
              "save files\nthere (unless they use Steam Cloud). Back up any saves you "
              "want to keep first.")

    if not sys.stdin.isatty():
        print("\nsteamspace: not running in a terminal; refusing to delete without "
              "confirmation.", file=sys.stderr)
        return 1
    try:
        answer = input(f"\nDelete these {len(victims)} folder{s}? Type 'yes' to confirm: ")
    except EOFError:
        answer = ""
    if answer.strip().lower() != "yes":
        print("Aborted; nothing was deleted.")
        return 1

    # Re-check just before deleting, in case Steam installed something meanwhile.
    local = local_names()
    freed = deleted = 0
    failed = []
    for size, appid, label, path in victims:
        if appid in local:
            print(f"skipped {path} ({label} is now installed)")
            continue
        if path.is_symlink() or not path.is_dir():
            print(f"skipped {path} (no longer a plain directory)")
            continue
        try:
            shutil.rmtree(path)
        except OSError as e:
            failed.append((path, e))
            continue
        freed += size
        deleted += 1
        print(f"deleted {path}")

    s = "" if deleted == 1 else "s"
    print(f"\nDeleted {deleted} folder{s}, freed {human(freed)}.")
    for path, e in failed:
        print(f"steamspace: could not delete {path}: {e}", file=sys.stderr)
    return 1 if failed else 0


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(
        description="Map Steam app IDs to game names. With no IDs, scan a "
        "directory whose subdirectories are app IDs and show their sizes."
    )
    ap.add_argument("ids", nargs="*", help="Steam app IDs")
    ap.add_argument("-d", "--dir", help="directory to scan (default: current directory)")
    ap.add_argument("-C", "--compatdata", action="store_true",
                    help="scan steamapps/compatdata in every Steam library")
    ap.add_argument("-S", "--shadercache", action="store_true",
                    help="scan steamapps/shadercache in every Steam library")
    ap.add_argument("-G", "--common", action="store_true",
                    help="scan steamapps/common (game install folders) in every Steam "
                    "library and highlight folders of uninstalled games")
    ap.add_argument("-u", "--uninstalled", action="store_true",
                    help="only show apps that are not installed (leftover folders)")
    ap.add_argument("--delete", action="store_true",
                    help="delete the leftover folders of uninstalled apps in the "
                    "scanned directories, after showing them and asking for confirmation")
    ap.add_argument("-s", "--sort", choices=["size", "id", "name"], default="size",
                    help="sort order in directory mode (default: size)")
    ap.add_argument("-a", "--all", action="store_true",
                    help="directory mode: also list non-numeric subdirectories")
    ap.add_argument("-o", "--offline", action="store_true",
                    help="don't query the Steam API (local manifests + cache only)")
    ap.add_argument("-r", "--refresh", action="store_true",
                    help="ignore cached API results and look them up again")
    ap.add_argument("-P", "--proton", action="store_true",
                    help="list extra Proton versions in compatibilitytools.d with their "
                    "sizes (alone, or together with -C/-S/-G/--dir)")
    args = ap.parse_args()

    lib_scan = args.compatdata or args.shadercache or args.common
    modes = sum(map(bool, (args.ids, args.dir, lib_scan)))
    if modes > 1:
        ap.error("give only one of: app IDs, --dir, or -C/-S/-G")
    if args.delete and args.common:
        ap.error("--delete doesn't work with -G; game folders in common/ are only reported")
    if args.delete and args.ids:
        ap.error("--delete works on directories (current dir, --dir, -C or -S), not app IDs")
    if args.proton and args.ids:
        ap.error("-P can't be combined with app IDs")
    if args.proton and args.delete:
        ap.error("-P can't be combined with --delete (Proton versions are never deleted)")
    if args.delete:
        args.uninstalled = True

    # -P on its own: just the Proton versions, no directory scan
    if args.proton and not modes:
        return report_proton(args)

    missing_libs = []
    libs = steam_library_dirs(missing_libs)
    have_libs = bool(libs)
    local = local_names()
    if not have_libs:
        print("steamspace: no Steam library found; can't tell what is installed",
              file=sys.stderr)
        if args.delete:
            return 1
    elif missing_libs and not args.delete:
        for m in missing_libs:
            print(f"steamspace: warning: Steam library not found (unmounted drive?): {m}\n"
                  f"            games installed there will show as uninstalled",
                  file=sys.stderr)

    # --- ID mode
    if args.ids:
        bad = [i for i in args.ids if not i.isdigit()]
        if bad:
            ap.error(f"not a numeric app ID: {', '.join(bad)}")
        ids = args.ids
        if args.uninstalled:
            ids = [i for i in ids if status(i, local, have_libs) == "uninstalled"]
        names = resolve(ids, local, args.offline, args.refresh)
        width = max((len(i) for i in ids), default=0)
        for i in ids:
            print(f"{i:<{width}}  {status(i, local, have_libs):<11}  {names[i] or UNKNOWN}")
        return 0 if all(names.values()) else 1

    # --- directory mode
    if lib_scan:
        if args.common and not have_libs:
            return 1
        wanted = [n for n, on in (("compatdata", args.compatdata),
                                  ("shadercache", args.shadercache),
                                  ("common", args.common)) if on]
        dirs = [lib / n for n in wanted for lib in libs if (lib / n).is_dir()]
        if not dirs:
            print(f"steamspace: no {' or '.join(wanted)} folder found in any Steam library",
                  file=sys.stderr)
            return 1
    else:
        base = Path(args.dir or ".").expanduser()
        if not base.is_dir():
            ap.error(f"not a directory: {base}")
        dirs = [base]

    rc = 0
    results = []
    for d in dirs:
        if args.common and d.name == "common" and d.parent in libs:
            rows = scan_common(d, args, [l for l in libs if l != d.parent])
        else:
            rows = scan_dir(d, args, local, have_libs)
        if rows is None:
            rc = 1
        else:
            results.append((d, rows))

    if args.delete:
        return delete_leftovers(results, missing_libs) or rc

    all_leftover = all_n = 0
    for n, (d, rows) in enumerate(results):
        if len(dirs) > 1:
            print(("\n" if n else "") + f"== {d}")
        rc |= print_rows(d, rows, args)
        for r in rows:
            if r[3] == "uninstalled":
                all_leftover += r[0]
                all_n += 1
    if len(dirs) > 1:
        s = "" if all_n == 1 else "s"
        print(f"\n{human(all_leftover):>6}  in {all_n} folder{s} of uninstalled apps, "
              f"across all {len(dirs)} directories")
    if args.proton:
        print()
        rc |= report_proton(args)
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print(file=sys.stderr)
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
